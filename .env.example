# 복사해서 .env로 저장한 뒤 python weather-widget/make_env.py 를 실행한다.
# 이 값은 env.js로 옮겨져 브라우저에 그대로 보인다. 비밀 값(API 키 등)은 넣지 않는다.

# Open-Meteo 예보 API 주소 (키 없음, 비상업 무료)
OPEN_METEO_URL=URL

TOUR_KEY=발급받은키

# 한국관광공사 TourAPI (국문 관광정보 서비스) — 시장 사진용, tools/images.py가 쓴다. Decoding 키
# 카카오맵 (kakaoAPI/CLAUDE.md 참고) — 키는 developers.kakao.com > 내 애플리케이션 > 앱 키
# JS 키: 브라우저 공개용. kakaoAPI/make_env.py가 kakaoAPI/env.js로 옮긴다. 콘솔에 등록한 도메인에서만 동작
KAKAO_JS_API_KEY=your_javascript_key
# REST 키: 비밀 값. tools/ 파이썬에서만 쓴다. env.js나 브라우저 코드에 절대 넣지 않는다
KAKAO_REST_API_KEY=your_rest_api_key


# 소상공인 API (SDSC) — 키는 https://developers.sbiz.or.kr/ > 내 애플리케이션 > 앱 키
SDSC_KEY=your_sdsc_key
